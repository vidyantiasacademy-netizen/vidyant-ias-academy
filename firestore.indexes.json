{
  "//": [
    "Composite indexes for the queries in src/services. Firestore serves",
    "single-field equality and single-field ordering automatically; every entry",
    "here is a query that combines them and would otherwise fail at runtime with",
    "FAILED_PRECONDITION.",
    "",
    "Only queries that exist in the code are listed. Each index costs storage and",
    "slows writes to its collection, so do not add speculative ones — Firestore's",
    "error message contains a direct link to create the index it actually needs.",
    "",
    "Two kinds of entry are rejected or wasted, and both are easy to add by",
    "reflex:",
    "",
    "1. A single-field entry. Firestore answers `orderBy(field)` from the",
    "   automatic single-field index, in both directions, and the deploy fails",
    "   with 'this index is not necessary, configure using single field index",
    "   controls'. Use `fieldOverrides` below to change single-field behaviour.",
    "2. An equality-only lookup with no `orderBy` — e.g. the payments lookup by",
    "   `razorpayOrderId`. One equality filter needs no composite index; adding",
    "   one is accepted but costs writes for nothing."
  ],
  "indexes": [
    {
      "//": "userService.listAll — the super admin's user list, filtered by role.",
      "collectionGroup": "users",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "role", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "studentService.listByMentor — a mentor's caseload.",
      "collectionGroup": "students",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "mentorUid", "order": "ASCENDING" },
        { "fieldPath": "fullName", "order": "ASCENDING" }
      ]
    },
    {
      "//": "courseService.listPublished — public course listing.",
      "collectionGroup": "courses",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "title", "order": "ASCENDING" }
      ]
    },
    {
      "//": "courseService.listPublished with a category filter.",
      "collectionGroup": "courses",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "category", "order": "ASCENDING" },
        { "fieldPath": "title", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Batches of one course, by start date.",
      "collectionGroup": "batches",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "courseId", "order": "ASCENDING" },
        { "fieldPath": "startDate", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Upcoming batches across courses — the homepage batch strip.",
      "collectionGroup": "batches",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "startDate", "order": "ASCENDING" }
      ]
    },
    {
      "//": "enrollmentService.listForStudent — the portal's first query.",
      "collectionGroup": "enrollments",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "studentUid", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "enrollmentService.listForCourse — admin roster.",
      "collectionGroup": "enrollments",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "courseId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "courseService.getLessons — ordered syllabus, published only.",
      "collectionGroup": "lessons",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "courseId", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "order", "order": "ASCENDING" }
      ]
    },
    {
      "//": "The same, narrowed to free-preview lessons for a visitor.",
      "collectionGroup": "lessons",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "courseId", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "isFreePreview", "order": "ASCENDING" },
        { "fieldPath": "order", "order": "ASCENDING" }
      ]
    },
    {
      "//": "testService.listForCourse — the test calendar.",
      "collectionGroup": "tests",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "courseId", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "opensAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "getQuestionsForAttempt — the paper's questions.",
      "collectionGroup": "questions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "testIds", "arrayConfig": "CONTAINS" },
        { "fieldPath": "status", "order": "ASCENDING" }
      ]
    },
    {
      "//": "PYQ database browsing: by subject and difficulty.",
      "collectionGroup": "questions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "subject", "order": "ASCENDING" },
        { "fieldPath": "difficulty", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "testService.listAttempts — a student's attempt history.",
      "collectionGroup": "testAttempts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "studentUid", "order": "ASCENDING" },
        { "fieldPath": "startedAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "createAttempt's resume/duplicate check.",
      "collectionGroup": "testAttempts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "testId", "order": "ASCENDING" },
        { "fieldPath": "studentUid", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" }
      ]
    },
    {
      "//": "findOwnAttempt — this student's latest sitting of one paper.",
      "collectionGroup": "testAttempts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "testId", "order": "ASCENDING" },
        { "fieldPath": "studentUid", "order": "ASCENDING" },
        { "fieldPath": "startedAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": [
        "sweepExpiredAttempts — sittings past their deadline that nobody",
        "submitted. The sweep is what makes 'closing the laptop does not pause",
        "the timer' true, so this index is load-bearing for invigilation, not an",
        "admin convenience."
      ],
      "collectionGroup": "testAttempts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "expiresAt", "order": "ASCENDING" }
      ]
    },
    {
      "//": "listProctorEvents — the invigilation log for one sitting, in order.",
      "collectionGroup": "proctorEvents",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "attemptId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Faculty evaluation queue: everyone who sat one paper.",
      "collectionGroup": "testAttempts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "testId", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "submittedAt", "order": "ASCENDING" }
      ]
    },
    {
      "//": "A student's results, newest first.",
      "collectionGroup": "results",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "studentUid", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Ranking a test: every result for it, by score.",
      "collectionGroup": "results",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "testId", "order": "ASCENDING" },
        { "fieldPath": "score", "order": "DESCENDING" }
      ]
    },
    {
      "//": "A student's doubts, newest first.",
      "collectionGroup": "doubts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "studentUid", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Faculty doubt queue: open doubts assigned to me, oldest first.",
      "collectionGroup": "doubts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "assignedTo", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "ASCENDING" }
      ]
    },
    {
      "//": "notificationService.listOwn — the portal's notification list.",
      "collectionGroup": "notifications",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "userUid", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "notificationService.countUnread — the header badge.",
      "collectionGroup": "notifications",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "userUid", "order": "ASCENDING" },
        { "fieldPath": "readAt", "order": "ASCENDING" }
      ]
    },
    {
      "//": "enquiryService.list — the CRM inbox, filtered by status.",
      "collectionGroup": "enquiries",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "The same, scoped to one counsellor's assignments.",
      "collectionGroup": "enquiries",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "assignedTo", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "The CRM inbox's \"Mine\" view with a status tab selected.",
      "collectionGroup": "enquiries",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "assignedTo", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "mockTestService.getResult — rank and percentile: scored sittings of one paper above / below a score. Range filters with no orderBy read the index ascending.",
      "collectionGroup": "mockAttempts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "testId", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "score", "order": "ASCENDING" }
      ]
    },
    {
      "//": "mockTestService.sweepExpired — abandoned sittings past their deadline.",
      "collectionGroup": "mockAttempts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "expiresAt", "order": "ASCENDING" }
      ]
    },
    {
      "//": "mockTestService.listForStaff — a paper's visitor sittings, newest first.",
      "collectionGroup": "mockAttempts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "testId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "paymentService.listForStudent — fee history.",
      "collectionGroup": "payments",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "studentUid", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "activityService.listForStudent — the learning timeline.",
      "collectionGroup": "activity",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "studentUid", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Activity of one type for one student — weakness analysis input.",
      "collectionGroup": "activity",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "studentUid", "order": "ASCENDING" },
        { "fieldPath": "type", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    }
  ],
  "fieldOverrides": [
    {
      "//": [
        "Firestore indexes every field of every document by default. These are",
        "large text fields that are never filtered or ordered on, so their",
        "indexes are pure write cost — and an indexed field over 1500 bytes",
        "fails the write outright, which a long Mains answer will do."
      ],
      "collectionGroup": "questions",
      "fieldPath": "statement",
      "indexes": []
    },
    {
      "collectionGroup": "questions",
      "fieldPath": "explanation",
      "indexes": []
    },
    {
      "collectionGroup": "questions",
      "fieldPath": "modelAnswer",
      "indexes": []
    },
    {
      "collectionGroup": "answers",
      "fieldPath": "text",
      "indexes": []
    },
    {
      "collectionGroup": "doubts",
      "fieldPath": "question",
      "indexes": []
    },
    {
      "collectionGroup": "doubts",
      "fieldPath": "answer",
      "indexes": []
    }
  ]
}
