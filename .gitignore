# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# firebase
.firebase/
firebase-debug.log*
firestore-debug.log*
database-debug.log*
pubsub-debug.log*
ui-debug.log*
# service-account keys — copy the values into env vars, never commit the file
*serviceAccount*.json
*service-account*.json
*-firebase-adminsdk-*.json

# sanity
/sanity/schema.json
/sanity.types.ts
.sanity/

# firebase emulators
firestore-debug.log
firebase-debug.log
ui-debug.log

# cloudflare wrangler local state
.wrangler/
.dev.vars*

# Claude Code skills (local tooling, not app code)
.claude/skills/
