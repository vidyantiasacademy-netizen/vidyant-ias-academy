{
  "name": "vidyantias",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "sanity:dev": "sanity dev",
    "sanity:typegen": "sanity schema extract && sanity typegen generate",
    "firebase:emulators": "bash scripts/emulators.sh",
    "seed:courses:firestore": "node scripts/seed-courses-firestore.mjs",
    "seed:courses:sanity": "sanity exec scripts/seed-courses-sanity.mjs --with-user-token",
    "seed:content:sanity": "sanity exec scripts/seed-content-sanity.mjs --with-user-token",
    "seed:notes:sanity": "sanity exec scripts/seed-notes-sanity.mjs --with-user-token --",
    "seed:pyq:sanity": "sanity exec scripts/seed-pyq-sanity.mjs --with-user-token --",
    "seed:answer-writing": "node scripts/seed-answer-writing-sample.mjs",
    "answer-writing:sample-pdf": "node scripts/generate-answer-writing-sample.mjs",
    "migrate:utc-instants": "node scripts/migrate-utc-instants.mjs",
    "emulator:seed": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 node scripts/seed-emulator.mjs",
    "dev:emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true next dev",
    "firebase:deploy:firestore": "firebase deploy --only firestore:rules,firestore:indexes",
    "brand:assets": "node --experimental-strip-types scripts/generate-brand-assets.mjs",
    "courses:posters": "node --experimental-strip-types scripts/generate-course-posters.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@sanity/document-internationalization": "^6.2.39",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.17.0",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-cloudinary": "^6.19.3",
    "next-sanity": "^13.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "sanity": "^6.17.0",
    "sanity-plugin-internationalized-array": "^5.3.2",
    "server-only": "^0.0.1",
    "styled-components": "^6.5.3",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sanity/client": "^7.27.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "^5.10.0"
    }
  }
}
